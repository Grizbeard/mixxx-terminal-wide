+std::optional<double> seratoTrackLengthInSeconds(const QString& text) {
+    // Minutes and seconds, or hours, minutes and seconds. Only the seconds
+    // have a fraction.
+    const QStringList parts = text.trimmed().split(QLatin1Char(':'));
+    if (parts.size() > 3) {
+        return std::nullopt;
+    }
+    double seconds = 0;
+    for (int i = 0; i < parts.size(); ++i) {
+        bool ok;
+        const double value = parts.at(i).toDouble(&ok);
+        if (!ok || !std::isfinite(value) || value < 0) {
+            return std::nullopt;
+        }
+        if (i < parts.size() - 1 && value != std::floor(value)) {
+            return std::nullopt;
+        }
+        seconds = seconds * 60 + value;
+    }
+    return seconds;
+}
