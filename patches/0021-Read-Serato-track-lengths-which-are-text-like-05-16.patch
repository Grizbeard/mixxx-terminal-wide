+/// Reads a track length as Serato's database stores it (tlen): text in
+/// minutes and seconds such as "05:16.81", with hours in front for long
+/// tracks. Returns the length in seconds, or nothing if the text is not one.
+std::optional<double> seratoTrackLengthInSeconds(const QString& text);
+
