     Q_OBJECT
   public:
diff --git a/src/test/seratotracklengthtest.cpp b/src/test/seratotracklengthtest.cpp
new file mode 100644
index 0000000000..a50d469863
--- /dev/null
+++ b/src/test/seratotracklengthtest.cpp
@@ -0,0 +1,34 @@
+#include <gtest/gtest.h>
+
+#include "library/serato/seratofeature.h"
+
+namespace {
+
+TEST(SeratoTrackLengthTest, MinutesAndSeconds) {
+    // As Serato's database V2 stores it.
+    EXPECT_DOUBLE_EQ(316.81, *seratoTrackLengthInSeconds(QStringLiteral("05:16.81")));
+    EXPECT_DOUBLE_EQ(225.0, *seratoTrackLengthInSeconds(QStringLiteral("03:45")));
+    EXPECT_DOUBLE_EQ(0.5, *seratoTrackLengthInSeconds(QStringLiteral("00:00.50")));
+}
+
+TEST(SeratoTrackLengthTest, HoursForLongTracks) {
+    EXPECT_DOUBLE_EQ(3723.25, *seratoTrackLengthInSeconds(QStringLiteral("1:02:03.25")));
+    // A mix over an hour may also just count the minutes on.
+    EXPECT_DOUBLE_EQ(4500.0, *seratoTrackLengthInSeconds(QStringLiteral("75:00.00")));
+}
+
+TEST(SeratoTrackLengthTest, PlainSeconds) {
+    EXPECT_DOUBLE_EQ(42.0, *seratoTrackLengthInSeconds(QStringLiteral("42")));
+}
+
+TEST(SeratoTrackLengthTest, NotALength) {
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QString()));
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QStringLiteral("   ")));
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QStringLiteral("abc")));
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QStringLiteral("05:")));
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QStringLiteral("05.5:16")));
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QStringLiteral("-1:00")));
+    EXPECT_FALSE(seratoTrackLengthInSeconds(QStringLiteral("1:2:3:4")));
+}
+
+} // namespace
