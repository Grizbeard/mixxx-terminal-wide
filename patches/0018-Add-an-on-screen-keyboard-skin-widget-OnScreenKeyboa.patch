+#pragma once
+
+#include <QPointer>
+#include <QString>
+#include <QWidget>
+
+#include "widget/wbasewidget.h"
+
+class QPushButton;
+
+/// A touch keyboard for typing into a text field, such as the library search
+/// box, on a panel that has no keyboard. Its keys never take the focus, so they
+/// type into whichever field has it, as a real keyboard would.
+///
+/// The skin decides when it is on screen, e.g. while [Library],focused_widget
+/// says the search box has the focus.
+class WOnScreenKeyboard : public QWidget, public WBaseWidget {
+    Q_OBJECT
+  public:
+    explicit WOnScreenKeyboard(QWidget* pParent = nullptr);
+
+    /// Type into pTarget rather than into the focused widget.
+    void setTarget(QWidget* pTarget) {
+        m_pTarget = pTarget;
+    }
+
+  protected:
+    bool event(QEvent* pEvent) override;
+
+  private:
+    QPushButton* addKey(const QString& label,
+            const QString& objectName,
+            int row,
+            int column,
+            int columnSpan = 1);
+    QWidget* target() const;
+    void sendKey(int key, const QString& text);
+    void clearText();
+    void done();
+
+    QPointer<QWidget> m_pTarget;
+};
