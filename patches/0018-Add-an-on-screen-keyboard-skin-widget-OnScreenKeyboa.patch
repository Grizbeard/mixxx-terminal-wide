diff --git a/src/test/wonscreenkeyboard_test.cpp b/src/test/wonscreenkeyboard_test.cpp
new file mode 100644
index 0000000000..d85c532c6f
--- /dev/null
+++ b/src/test/wonscreenkeyboard_test.cpp
@@ -0,0 +1,66 @@
+#include "widget/wonscreenkeyboard.h"
+
+#include <gtest/gtest.h>
+
+#include <QComboBox>
+#include <QLineEdit>
+#include <QPushButton>
+
+namespace {
+
+class WOnScreenKeyboardTest : public ::testing::Test {
+  protected:
+    void press(const QString& label) {
+        for (QPushButton* pKey : keyboard.findChildren<QPushButton*>()) {
+            if (pKey->text() == label) {
+                pKey->click();
+                return;
+            }
+        }
+        FAIL() << "no key " << label.toStdString();
+    }
+
+    WOnScreenKeyboard keyboard;
+};
+
+} // namespace
+
+TEST_F(WOnScreenKeyboardTest, keysTypeIntoTheTarget) {
+    QLineEdit lineEdit;
+    keyboard.setTarget(&lineEdit);
+    for (const QString& key : {"d", "j", "r", "u", "m", "space", "9", "-", "'", "."}) {
+        press(key);
+    }
+    EXPECT_EQ(QStringLiteral("djrum 9-'."), lineEdit.text());
+    press(QStringLiteral("⌫"));
+    EXPECT_EQ(QStringLiteral("djrum 9-'"), lineEdit.text());
+    press(QStringLiteral("clear"));
+    EXPECT_TRUE(lineEdit.text().isEmpty());
+}
+
+TEST_F(WOnScreenKeyboardTest, clearEmptiesAnEditableComboBox) {
+    // The library search box is an editable combo box.
+    QComboBox comboBox;
+    comboBox.setEditable(true);
+    keyboard.setTarget(&comboBox);
+    press(QStringLiteral("a"));
+    press(QStringLiteral("b"));
+    EXPECT_EQ(QStringLiteral("ab"), comboBox.currentText());
+    press(QStringLiteral("clear"));
+    EXPECT_TRUE(comboBox.currentText().isEmpty());
+}
+
+TEST_F(WOnScreenKeyboardTest, keysNeverTakeTheFocus) {
+    EXPECT_EQ(Qt::NoFocus, keyboard.focusPolicy());
+    const auto keys = keyboard.findChildren<QPushButton*>();
+    EXPECT_EQ(40 + 3, keys.size());
+    for (QPushButton* pKey : keys) {
+        EXPECT_EQ(Qt::NoFocus, pKey->focusPolicy()) << pKey->text().toStdString();
+    }
+}
+
+TEST_F(WOnScreenKeyboardTest, withNothingFocusedKeysDoNothing) {
+    press(QStringLiteral("a"));
+    press(QStringLiteral("done"));
+    press(QStringLiteral("clear"));
+}
diff --git a/src/widget/wonscreenkeyboard.cpp b/src/widget/wonscreenkeyboard.cpp
new file mode 100644
index 0000000000..b9358bc432
--- /dev/null
+++ b/src/widget/wonscreenkeyboard.cpp
@@ -0,0 +1,160 @@
+#include "widget/wonscreenkeyboard.h"
+
+#include <QApplication>
+#include <QComboBox>
+#include <QEvent>
+#include <QGridLayout>
+#include <QKeyEvent>
+#include <QLineEdit>
+#include <QPushButton>
+
+#include "moc_wonscreenkeyboard.cpp"
+
+namespace {
+
+constexpr int kColumns = 10;
+
+// Search text is matched without regard to case, so there is no shift.
+const QString kRows[] = {
+        QStringLiteral("1234567890"),
+        QStringLiteral("qwertyuiop"),
+        QStringLiteral("asdfghjkl"),
+        QStringLiteral("zxcvbnm-.'"),
+};
+
+int keyForCharacter(QChar c) {
+    if (c >= QLatin1Char('a') && c <= QLatin1Char('z')) {
+        return Qt::Key_A + (c.unicode() - 'a');
+    }
+    if (c >= QLatin1Char('0') && c <= QLatin1Char('9')) {
+        return Qt::Key_0 + (c.unicode() - '0');
+    }
+    switch (c.unicode()) {
+    case '-':
+        return Qt::Key_Minus;
+    case '.':
+        return Qt::Key_Period;
+    case '\'':
+        return Qt::Key_Apostrophe;
+    default:
+        return Qt::Key_unknown;
+    }
+}
+
+} // namespace
+
+WOnScreenKeyboard::WOnScreenKeyboard(QWidget* pParent)
+        : QWidget(pParent),
+          WBaseWidget(this) {
+    // Tapping the keyboard itself must leave the focus where it is.
+    setFocusPolicy(Qt::NoFocus);
+    auto* pLayout = new QGridLayout(this);
+    pLayout->setContentsMargins(0, 0, 0, 0);
+    pLayout->setSpacing(0);
+    for (int column = 0; column < kColumns; ++column) {
+        pLayout->setColumnStretch(column, 1);
+    }
+
+    int row = 0;
+    for (const QString& characters : kRows) {
+        for (int column = 0; column < characters.size(); ++column) {
+            const QChar c = characters.at(column);
+            QPushButton* pKey = addKey(QString(c), QStringLiteral("KeyboardKey"), row, column);
+            connect(pKey, &QPushButton::clicked, this, [this, c]() {
+                sendKey(keyForCharacter(c), QString(c));
+            });
+        }
+        ++row;
+    }
+
+    // Backspace ends the row with nine letters, where a keyboard has it.
+    QPushButton* pBackspace = addKey(
+            QStringLiteral("⌫"), QStringLiteral("KeyboardAction"), 2, kColumns - 1);
+    pBackspace->setAutoRepeat(true);
+    pBackspace->setAutoRepeatDelay(400);
+    pBackspace->setAutoRepeatInterval(60);
+    connect(pBackspace, &QPushButton::clicked, this, [this]() {
+        sendKey(Qt::Key_Backspace, QString());
+    });
+
+    connect(addKey(QStringLiteral("clear"), QStringLiteral("KeyboardAction"), row, 0, 2),
+            &QPushButton::clicked,
+            this,
+            &WOnScreenKeyboard::clearText);
+    connect(addKey(QStringLiteral("space"), QStringLiteral("KeyboardSpace"), row, 2, 6),
+            &QPushButton::clicked,
+            this,
+            [this]() {
+                sendKey(Qt::Key_Space, QStringLiteral(" "));
+            });
+    connect(addKey(QStringLiteral("done"), QStringLiteral("KeyboardAction"), row, 8, 2),
+            &QPushButton::clicked,
+            this,
+            &WOnScreenKeyboard::done);
+}
+
+QPushButton* WOnScreenKeyboard::addKey(const QString& label,
+        const QString& objectName,
+        int row,
+        int column,
+        int columnSpan) {
+    auto* pKey = new QPushButton(label, this);
+    pKey->setObjectName(objectName);
+    pKey->setFocusPolicy(Qt::NoFocus);
+    pKey->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+    static_cast<QGridLayout*>(layout())->addWidget(pKey, row, column, 1, columnSpan);
+    return pKey;
+}
+
+QWidget* WOnScreenKeyboard::target() const {
+    if (m_pTarget) {
+        return m_pTarget;
+    }
+    return QApplication::focusWidget();
+}
+
+void WOnScreenKeyboard::sendKey(int key, const QString& text) {
+    QWidget* pTarget = target();
+    if (!pTarget) {
+        return;
+    }
+    QKeyEvent press(QEvent::KeyPress, key, Qt::NoModifier, text);
+    QApplication::sendEvent(pTarget, &press);
+    QKeyEvent release(QEvent::KeyRelease, key, Qt::NoModifier, text);
+    QApplication::sendEvent(pTarget, &release);
+}
+
+void WOnScreenKeyboard::clearText() {
+    QWidget* pTarget = target();
+    // An editable combo box, such as the search box, keeps its text in a line
+    // edit; clearing that one reaches the box's text-changed signals.
+    if (auto* pComboBox = qobject_cast<QComboBox*>(pTarget)) {
+        if (pComboBox->lineEdit()) {
+            pComboBox->lineEdit()->clear();
+        }
+    } else if (auto* pLineEdit = qobject_cast<QLineEdit*>(pTarget)) {
+        pLineEdit->clear();
+    }
+}
+
+void WOnScreenKeyboard::done() {
+    QWidget* pTarget = target();
+    if (!pTarget) {
+        return;
+    }
+    // Return runs the search and moves on to the results. The search box only
+    // moves on once its search has gone out, so a second Return follows when
+    // the first one only ran it; Escape would move on without saving the
+    // search to its history.
+    sendKey(Qt::Key_Return, QStringLiteral("\r"));
+    if (target() == pTarget && pTarget->hasFocus()) {
+        sendKey(Qt::Key_Return, QStringLiteral("\r"));
+    }
+}
+
+bool WOnScreenKeyboard::event(QEvent* pEvent) {
+    if (pEvent->type() == QEvent::ToolTip) {
+        updateTooltip();
+    }
+    return QWidget::event(pEvent);
+}
