diff --git a/src/test/keyutilstest.cpp b/src/test/keyutilstest.cpp
index 1f74d05fa4..8138226ef0 100644
--- a/src/test/keyutilstest.cpp
+++ b/src/test/keyutilstest.cpp
@@ -68,6 +68,25 @@ TEST_F(KeyUtilsTest, KeyTextWithoutIdFollowsTheNotation) {
     EXPECT_TRUE(KeyUtils::keyFromKeyTextAndIdFields(QVariant(), QVariant()).isNull());
 }
 
+TEST_F(KeyUtilsTest, ChromaticKeyFromKeyTextAndIdFields) {
+    // The key id wins over the text; without one, the text is read as a key,
+    // which is what colours a Serato or Rekordbox library's keys.
+    EXPECT_EQ(mixxx::track::io::key::C_MAJOR,
+            KeyUtils::chromaticKeyFromKeyTextAndIdFields(QVariant(QStringLiteral("Am")),
+                    QVariant(static_cast<int>(mixxx::track::io::key::C_MAJOR))));
+    for (const char* text : {"Am", "8A", "1m"}) {
+        EXPECT_EQ(mixxx::track::io::key::A_MINOR,
+                KeyUtils::chromaticKeyFromKeyTextAndIdFields(
+                        QVariant(QString(text)), QVariant()))
+                << text;
+    }
+    EXPECT_EQ(mixxx::track::io::key::INVALID,
+            KeyUtils::chromaticKeyFromKeyTextAndIdFields(
+                    QVariant(QStringLiteral("not a key")), QVariant()));
+    EXPECT_EQ(mixxx::track::io::key::INVALID,
+            KeyUtils::chromaticKeyFromKeyTextAndIdFields(QVariant(), QVariant()));
+}
