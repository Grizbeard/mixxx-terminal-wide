diff --git a/src/track/keyutils.cpp b/src/track/keyutils.cpp
index 9c4210f174..d36373c013 100644
--- a/src/track/keyutils.cpp
+++ b/src/track/keyutils.cpp
@@ -856,6 +856,23 @@ QVariant KeyUtils::keyFromKeyTextAndIdFields(
     return QVariant{KeyUtils::keyToString(key)};
 }
 
+// static
+mixxx::track::io::key::ChromaticKey KeyUtils::chromaticKeyFromKeyTextAndIdFields(
+        const QVariant& keyTextField, const QVariant& keyIdField) {
+    if (keyIdField.isNull()) {
+        if (keyTextField.isNull()) {
+            return mixxx::track::io::key::INVALID;
+        }
+        return guessKeyFromText(keyTextField.toString());
+    }
+    bool ok;
+    const auto keyId = keyIdField.toInt(&ok);
+    if (!ok) {
+        return mixxx::track::io::key::INVALID;
+    }
+    return keyFromNumericValue(keyId);
+}
+
 // static
 QString KeyUtils::keyFromKeyTextAndIdValues(const QString& keyText, const ChromaticKey& keyId) {
     return keyId == mixxx::track::io::key::INVALID ? keyTextInUserNotation(keyText)
