+std::optional<BeatsPointer> Beats::tryMoveFirstMarker(int beats) const {
+    const audio::FrameDiff_t lastBeatLength = lastBeatLengthFrames();
+    if (hasConstantTempo()) {
+        // Rounded once, so moving back and forth returns to the same position.
+        const auto lastMarkerPosition =
+                (m_lastMarkerPosition + beats * lastBeatLength).toNearestFrameBoundary();
+        return BeatsPointer(new Beats(m_markers,
+                lastMarkerPosition,
+                m_lastMarkerBpm,
+                m_sampleRate,
+                m_subVersion));
+    }
+
+    std::vector<BeatMarker> markers = m_markers;
+    auto lastMarkerPosition = m_lastMarkerPosition;
+    // The beat length from the first marker on, which is also what the grid
+    // continues with before it.
+    const auto firstBeatLength = [&]() -> audio::FrameDiff_t {
+        if (markers.empty()) {
+            return lastBeatLength;
+        }
+        const audio::FramePos nextPosition =
+                markers.size() > 1 ? markers[1].position() : lastMarkerPosition;
+        return (nextPosition - markers.front().position()) /
+                markers.front().beatsTillNextMarker();
+    };
+
+    // Earlier: a one-beat section in front, as long as the first one's beats.
+    for (; beats < 0; ++beats) {
+        if (markers.empty()) {
+            lastMarkerPosition =
+                    (lastMarkerPosition - lastBeatLength).toNearestFrameBoundary();
+            continue;
+        }
+        const auto position =
+                (markers.front().position() - firstBeatLength()).toNearestFrameBoundary();
+        markers.insert(markers.begin(), BeatMarker(position, 1));
+    }
+    // Later: the first section loses its first beat, or goes if that was all.
+    for (; beats > 0; --beats) {
+        if (markers.empty()) {
+            lastMarkerPosition =
+                    (lastMarkerPosition + lastBeatLength).toNearestFrameBoundary();
+            continue;
+        }
+        const BeatMarker first = markers.front();
+        const audio::FrameDiff_t length = firstBeatLength();
+        if (first.beatsTillNextMarker() > 1) {
+            markers.front() = BeatMarker(
+                    (first.position() + length).toNearestFrameBoundary(),
+                    first.beatsTillNextMarker() - 1);
+            continue;
+        }
+        markers.erase(markers.begin());
+        // The removed beat is now reached by continuing the next section
+        // backwards, which only puts it back in place at the same tempo.
+        if (std::abs(firstBeatLength() - length) > 1) {
+            return std::nullopt;
+        }
+    }
+
+    return BeatsPointer(new Beats(std::move(markers),
+            lastMarkerPosition,
+            m_lastMarkerBpm,
+            m_sampleRate,
+            m_subVersion));
+}
