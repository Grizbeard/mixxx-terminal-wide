+        m_pDownbeatsNode = pNode.get();
+        m_pDownbeatsNode->initForRectangles<UniColorMaterial>(0);
+        appendChildNode(std::move(pNode));
+    }
+    {
+        auto pNode = std::make_unique<DigitsRenderNode>();
+        m_pBarNumbersNode = pNode.get();
+        appendChildNode(std::move(pNode));
+    }
     setUsePreprocess(true);
 }
 
 void WaveformRenderBeat::setup(const QDomNode& node, const SkinContext& skinContext) {
     m_color = QColor(skinContext.selectString(node, QStringLiteral("BeatColor")));
     m_color = WSkinColor::getCorrectColor(m_color).toRgb();
+
+    // No DownbeatColor, no bars: a skin that does not know about them looks
+    // as it always has.
+    m_downbeatColor = colorFromSkin(skinContext, node, QStringLiteral("DownbeatColor"));
+    m_barNumberColor = colorFromSkin(skinContext, node, QStringLiteral("BarNumberColor"));
+    if (!m_barNumberColor.isValid()) {
+        m_barNumberColor = m_downbeatColor;
+    }
+    // A CSS-style list, e.g. 'Cascadia Mono','DejaVu Sans Mono',monospace
+    m_barNumberFontFamilies.clear();
+    const QString fonts = skinContext.selectString(node, QStringLiteral("BarNumberFont"));
+    for (QString family : fonts.split(QChar(','), Qt::SkipEmptyParts)) {
+        family = family.trimmed();
+        family.remove(QChar('\''));
+        family.remove(QChar('"'));
+        if (!family.isEmpty()) {
+            m_barNumberFontFamilies.append(family);
+        }
+    }
+    m_barNumberFontSize = skinContext.selectFloat(
+            node, QStringLiteral("BarNumberSize"), kDefaultBarNumberFontSize);
