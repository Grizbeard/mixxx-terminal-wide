+void BpmControl::slotDownbeatEarlier(double v) {
+    if (v <= 0) {
+        return;
+    }
+    moveDownbeat(-1);
+}
+
+void BpmControl::slotDownbeatLater(double v) {
+    if (v <= 0) {
+        return;
+    }
+    moveDownbeat(1);
+}
+
+void BpmControl::moveDownbeat(int beats) {
+    const TrackPointer pTrack = getEngineBuffer()->getLoadedTrack();
+    if (!pTrack) {
+        return;
+    }
+    const mixxx::BeatsPointer pBeats = pTrack->getBeats();
+    if (!pBeats) {
+        return;
+    }
+    const auto movedBeats = pBeats->tryMoveFirstMarker(beats);
+    if (!movedBeats) {
+        qWarning() << "Cannot move the downbeat of" << getGroup()
+                   << "without moving its beats";
+        return;
+    }
+    // Every beat stays where it was, so this is allowed with the BPM locked.
+    pTrack->setBeatsKeepingBeatPositions(*movedBeats);
+}
