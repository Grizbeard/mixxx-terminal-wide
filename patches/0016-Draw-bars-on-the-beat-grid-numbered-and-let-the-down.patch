+void allshader::DigitsRenderNode::update(const std::vector<Text>& texts) {
+    const int numVerticesPerRectangle = 6;
+    int reserved = 0;
+    for (const auto& text : texts) {
+        reserved += static_cast<int>(text.digits.length()) * numVerticesPerRectangle;
+    }
+    geometry().allocate(reserved);
+    TexturedVertexUpdater vertexUpdater{geometry().vertexDataAs<Geometry::TexturedPoint2D>()};
+    for (const auto& text : texts) {
+        addVertices(vertexUpdater, text.x, text.y, text.digits);
+    }
+
+    DEBUG_ASSERT(reserved == vertexUpdater.index());
+    markDirtyGeometry();
+    markDirtyMaterial();
+}
+
+float allshader::DigitsRenderNode::width(const QString& digits) const {
+    // As addVertices() lays them out: each character's outline overlaps the
+    // one before it.
+    const float space = static_cast<float>(m_penWidth) / 2;
+    float w = 0.f;
+    for (QChar c : digits) {
+        if (w != 0.f) {
+            w -= space;
+        }
+        w += m_width[charToIndex(c)];
+    }
+    return w;
+}
