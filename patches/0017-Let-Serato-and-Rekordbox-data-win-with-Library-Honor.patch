+            3,
+            mixxx::audio::FramePos(200),
+            mixxx::audio::kInvalidFramePos);
+    pTrack->importCueInfos(hotCue1AtOneSecond(), true);
+    const auto cues = hotCues(pTrack);
+    // Only what was imported: the cue on hot cue 4 is gone too.
+    ASSERT_EQ(1, cues.size());
