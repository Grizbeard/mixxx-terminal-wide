+// A parsed test track with its audio opened once, so imports apply at once.
+TrackPointer newTestTrackWithStreamInfo() {
+    auto pTrack = Track::newTemporary(
+            QDir(MixxxTest::getOrInitTestDir().filePath(QStringLiteral("id3-test-data"))),
+            "TOAL_TPE2.mp3");
+    SoundSourceProxy proxy(pTrack);
+    proxy.updateTrackFromSource(
+            SoundSourceProxy::UpdateTrackFromSourceMode::Once,
+            SyncTrackMetadataParams{});
+    auto pAudioSource = proxy.openAudioSource();
+    EXPECT_NE(nullptr, pAudioSource);
+    if (pAudioSource) {
+        pAudioSource->close();
+    }
+    return pTrack;
+}
+
+// A locked track at 100 BPM.
+TrackPointer newLockedTestTrack() {
+    auto pTrack = newTestTrackWithStreamInfo();
+    EXPECT_TRUE(pTrack->trySetBeats(mixxx::Beats::fromConstTempo(
+            pTrack->getSampleRate(), mixxx::audio::kStartFramePos, mixxx::Bpm(100))));
+    pTrack->setBpmLocked(true);
+    return pTrack;
+}
+
+std::unique_ptr<mixxx::CueInfoImporter> hotCue1AtOneSecond() {
+    return std::make_unique<mixxx::CueInfoImporter>(QList<mixxx::CueInfo>{
+            mixxx::CueInfo(mixxx::CueType::HotCue,
+                    1000.0,
+                    std::nullopt,
+                    0,
+                    QString(),
+                    mixxx::RgbColor::nullopt())});
+}
+
+QList<CuePointer> hotCues(const TrackPointer& pTrack) {
+    QList<CuePointer> cues;
+    for (const auto& pCue : pTrack->getCuePoints()) {
+        if (pCue->getType() == mixxx::CueType::HotCue) {
+            cues.append(pCue);
+        }
+    }
+    return cues;
+}
+
+} // namespace
