<!DOCTYPE template>
<!--
  Description:
    One whole effect unit: which unit the page is showing, what it is routed
    to, whether it is on, its dry/wet and super knobs, and its three slots side
    by side, one column each.

    Routing is a pair of buttons rather than a fixed wiring, so a unit can be
    put on the other deck or on both mid-set. Units 1 and 3 start on deck 1 and
    units 2 and 4 on deck 2, seeded in the config rather than asserted by the
    skin.

    The header also carries the unit's chain preset - saved and recalled as a
    whole, all three slots at once.

    A unit is either an insert or a return, and the header shows which. An
    insert (pre-fader: its output goes through the mixer's channel fader) has
    dry/wet, mix mode and deck routing. A return (post-fader: wet_only, fed from
    a crossfader bus and sent out past the faders) has none of those - its mix
    knob is the send level, which the DJM-T1_Custom mapping drives from the
    channel fader, and its routing is fixed. Both sets are laid out and each
    shows itself by [EffectRack1_EffectUnitN],wet_only, so the page says what
    the engine is doing rather than what the unit number suggests. On a Mixxx
    without the wet-only patch that control does not exist, the skin creates it
    at 0, and every unit reads pre-fader - which there is true.

  Variables:
    FxUnit: 1 to 4
-->
<Template>
  <SetVariable name="FxUnitGroup">[EffectRack1_EffectUnit<Variable name="FxUnit"/>]</SetVariable>

  <WidgetGroup>
    <ObjectName>FxUnitPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>FxUnitHeader</ObjectName>
        <Layout>horizontal</Layout>
        <!-- The unit's own knobs live in this row rather than one of their
             own: a row costs 78px, and three slots of parameters want it
             more than a second line of unit controls does. -->
        <Size>0me,68f</Size>
        <Children>
          <!-- The unit picker. It stands where the unit's name used to, and
               is its name: the lit button says which unit the rest of the
               page is editing. -->
          <WidgetGroup>
            <ObjectName>FxUnitTabs</ObjectName>
            <Layout>horizontal</Layout>
            <Size>308f,42f</Size>
            <Children>
              <Template src="skin:templates/fx_unit_tab.xml">
                <SetVariable name="FxUnit">1</SetVariable>
                <SetVariable name="FxPage">0</SetVariable>
              </Template>
              <Template src="skin:templates/fx_unit_tab.xml">
                <SetVariable name="FxUnit">2</SetVariable>
                <SetVariable name="FxPage">1</SetVariable>
              </Template>
              <Template src="skin:templates/fx_unit_tab.xml">
                <SetVariable name="FxUnit">3</SetVariable>
                <SetVariable name="FxPage">2</SetVariable>
              </Template>
              <Template src="skin:templates/fx_unit_tab.xml">
                <SetVariable name="FxUnit">4</SetVariable>
                <SetVariable name="FxPage">3</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <Label>
            <ObjectName>FxFaderPost</ObjectName>
            <TooltipId>EffectUnit_mix</TooltipId>
            <Size>112f,42f</Size>
            <Text>post-fader</Text>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </Label>
          <Label>
            <ObjectName>FxFaderPre</ObjectName>
            <Size>112f,42f</Size>
            <Text>pre-fader</Text>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </Label>
          <PushButton>
            <ObjectName>FxUnitEnable</ObjectName>
            <TooltipId>EffectUnit_enabled</TooltipId>
            <Size>76f,42f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>on</Text></State>
            <State><Number>1</Number><Text>on</Text></State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxMixMode</ObjectName>
            <TooltipId>EffectUnit_mix_mode</TooltipId>
            <Size>84f,42f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>d/w</Text></State>
            <State><Number>1</Number><Text>d+w</Text></State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,mix_mode</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </PushButton>

          <!-- One control, two meanings. For an insert the mix knob is
               dry/wet; for a return it is the send level into the effects,
               and the channel fader is what normally moves it. -->
          <WidgetGroup>
            <ObjectName>FxMixBox</ObjectName>
            <Layout>horizontal</Layout>
            <Size>84f,64f</Size>
            <Children>
              <Template src="skin:templates/fx_knob.xml">
                <SetVariable name="ObjectName">FxMixKnob</SetVariable>
                <SetVariable name="TooltipId">EffectUnit_mix</SetVariable>
                <SetVariable name="Caption">dry/wet</SetVariable>
                <SetVariable name="ArcColor"><Variable name="ArcColorFxMix"/></SetVariable>
                <SetVariable name="ConfigKey"><Variable name="FxUnitGroup"/>,mix</SetVariable>
              </Template>
            </Children>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>FxMixBox</ObjectName>
            <Layout>horizontal</Layout>
            <Size>84f,64f</Size>
            <Children>
              <Template src="skin:templates/fx_knob.xml">
                <SetVariable name="ObjectName">FxMixKnob</SetVariable>
                <SetVariable name="TooltipId">EffectUnit_mix</SetVariable>
                <SetVariable name="Caption">send</SetVariable>
                <SetVariable name="ArcColor"><Variable name="ArcColorFxMix"/></SetVariable>
                <SetVariable name="ConfigKey"><Variable name="FxUnitGroup"/>,mix</SetVariable>
              </Template>
            </Children>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
          <Template src="skin:templates/fx_knob.xml">
            <SetVariable name="ObjectName">FxSuperKnob</SetVariable>
            <SetVariable name="TooltipId">EffectUnit_super1</SetVariable>
            <SetVariable name="Caption">super</SetVariable>
            <SetVariable name="ArcColor"><Variable name="ArcColorSuper"/></SetVariable>
            <SetVariable name="ConfigKey"><Variable name="FxUnitGroup"/>,super1</SetVariable>
          </Template>

          <!-- Chain presets: the whole unit - all three slots, their effects and
               their parameters - saved and recalled as one thing.

               Two widgets rather than one. The selector is the recall path and,
               more to the point, the only thing on the page that says which
               preset is loaded. The button beside it opens the menu that saves:
               update the current preset, rename it, save as a new one, and take
               per-slot snapshots. The menu lists the presets too, so it can
               recall as well - but a combo box is the better target for that on
               a touchscreen, and a name you can read beats a name you have to
               open a menu to see. -->
          <EffectChainPresetSelector>
            <ObjectName>FxPresetSelector</ObjectName>
            <TooltipId>EffectUnit_chain_selector</TooltipId>
            <SizePolicy>me,f</SizePolicy>
            <Size>0me,42f</Size>
            <EffectUnit><Variable name="FxUnit"/></EffectUnit>
          </EffectChainPresetSelector>

          <EffectChainPresetButton>
            <ObjectName>FxPresetButton</ObjectName>
            <TooltipId>EffectUnit_chain_preset_menu</TooltipId>
            <Size>76f,42f</Size>
            <EffectUnit><Variable name="FxUnit"/></EffectUnit>
          </EffectChainPresetButton>

          <Label>
            <ObjectName>FxRouteLabel</ObjectName>
            <Size>56f,42f</Size>
            <Text>route</Text>
          </Label>
          <WidgetGroup>
            <ObjectName>FxRouteBox</ObjectName>
            <Layout>horizontal</Layout>
            <Size>124f,42f</Size>
            <Children>
              <PushButton>
                <ObjectName>FxRouteButton</ObjectName>
                <TooltipId>EffectUnit_deck_enabled</TooltipId>
                <Size>62f,42f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>1</Text></State>
                <State><Number>1</Number><Text>1</Text></State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>,group_[Channel1]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>FxRouteButton</ObjectName>
                <TooltipId>EffectUnit_deck_enabled</TooltipId>
                <Size>62f,42f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>2</Text></State>
                <State><Number>1</Number><Text>2</Text></State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>,group_[Channel2]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
          <!-- A return's routing, read-only. Its input is a crossfader bus,
               and a bus holding one deck is that deck: bus L is deck 1 and bus
               R deck 2 with the orientations the mapping sets. The buttons do
               not write, because unrouting a return does not silence it - the
               bus would reach the main output dry, a second copy of that deck
               on the master. -->
          <WidgetGroup>
            <ObjectName>FxRouteBox</ObjectName>
            <Layout>horizontal</Layout>
            <Size>124f,42f</Size>
            <Children>
              <PushButton>
                <ObjectName>FxRouteButton</ObjectName>
                <TooltipId>EffectUnit_deck_enabled</TooltipId>
                <Size>62f,42f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>1</Text></State>
                <State><Number>1</Number><Text>1</Text></State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>,group_[BusLeft]_enable</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>FxRouteButton</ObjectName>
                <TooltipId>EffectUnit_deck_enabled</TooltipId>
                <Size>62f,42f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>2</Text></State>
                <State><Number>1</Number><Text>2</Text></State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>,group_[BusRight]_enable</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,wet_only</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <!-- The three slots as equal columns. Each column's width policy is
           Ignored (fx_slot.xml), so the row splits evenly whatever the loaded
           effects are called or however many parameters they have - a column
           that sized itself to its contents would move every time an effect
           was swapped. -->
      <WidgetGroup>
        <ObjectName>FxSlots</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <Template src="skin:fx_slot.xml">
            <SetVariable name="FxNum">1</SetVariable>
          </Template>
          <Template src="skin:fx_slot.xml">
            <SetVariable name="FxNum">2</SetVariable>
          </Template>
          <Template src="skin:fx_slot.xml">
            <SetVariable name="FxNum">3</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
